# BoxLite v0.9.7 src/boxlite/src/jailer/apparmor.rs generate_bwrap_profile.
# https://github.com/boxlite-ai/boxlite/blob/v0.9.7/src/boxlite/src/jailer/apparmor.rs
# Only executable attachment and profile names differ from upstream.
# Broad setup permissions; stacked child denies capabilities after exec.
abi <abi/4.0>,
include <tunables/global>

profile xagent_ci_bwrap /usr/bin/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &xagent_ci_bwrap//&xagent_ci_unpriv_bwrap,
}

profile xagent_ci_unpriv_bwrap flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &xagent_ci_unpriv_bwrap,
  audit deny capability,
}
